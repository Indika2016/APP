# Supabase Postgres connection string used by the long-running collector process.
# Use the SESSION-mode connection (or a direct connection), not the transaction
# pooler -- this process holds one connection open for hours/days, which is
# exactly what session mode is for. Get it from:
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> "Session pooler"
# (Netlify's functions use a *different* connection string -- the transaction
# pooler -- since those are many short-lived invocations. See web/.env.example.)
#
# Never commit the real value of this file. Only .env.example (with no secret)
# is checked into git.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
