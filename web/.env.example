# Supabase Postgres connection string for the Netlify Functions (many
# short-lived serverless invocations) -- use the TRANSACTION pooler, not the
# session one the collector uses. Get it from:
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543, not 5432)
#
# Set this as a Netlify environment variable (Site settings -> Environment
# variables), not in a committed file. Only .env.example (no secret) is
# checked into git.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
